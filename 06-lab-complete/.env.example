# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng:  cp .env.example .env   rồi sửa .env  (file .env đã nằm trong .gitignore)
# Trên Railway / Render: đặt các biến này trong dashboard của nền tảng.
# ============================================================

# Cổng lắng nghe. Railway/Render tự cấp PORT; chạy local mặc định 8000.
PORT=8000

# development | staging | production  (production sẽ tắt /docs)
ENVIRONMENT=development

# Khoá bắt buộc trong header X-API-Key khi gọi POST /ask.
# Để trống thì agent từ chối mọi request. Sinh khoá: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis cho rate limiter và cost guard.
# Chạy bằng docker compose thì compose tự đặt thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Số request tối đa cho mỗi API key trong 60 giây (vượt thì 429)
RATE_LIMIT_PER_MINUTE=10

# Ngân sách LLM mỗi ngày (USD, tính chung cho cả hệ thống). Vượt thì 402.
DAILY_BUDGET_USD=1.0
